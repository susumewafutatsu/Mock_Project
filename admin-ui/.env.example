# Frontend Environment Variables
# Sao chép file này thành .env.local và điền giá trị thực

# URL gốc của Backend API
VITE_API_BASE_URL=http://localhost:8080/api

# Gốc backend (không có /api) — dùng cho endpoint OAuth2 của Spring Security
VITE_BACKEND_BASE_URL=http://localhost:8080

# URL redirect sau khi Google OAuth2 thành công (phải nằm trong whitelist
# app.oauth2.authorized-redirect-uris ở backend application.yml)
VITE_OAUTH2_REDIRECT_URL=http://localhost:5173/auth/callback
